# Flask API base URL (local: http://localhost:5000, Railway: your Railway URL)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Database — Supabase → Project Settings → Database → Connection string (Transaction mode)
DATABASE_URL=

# Open Exchange Rates — openexchangerates.org → Dashboard → App ID
OPEN_EXCHANGE_RATES_KEY=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project URL for backend JWT verification (e.g. https://xxxx.supabase.co)
# The JWKS endpoint is derived as ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_URL=
# Optional explicit override if your JWKS lives elsewhere
# SUPABASE_JWKS_URL=

# Comma-separated list of allowed CORS origins (Flask backend)
# Defaults to http://localhost:3000 if unset
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
